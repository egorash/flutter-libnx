# Referenz-Checkouts und heruntergeladene Upstream-Quellen (nicht versionieren)
third_party/libnx/
third_party/reference/
third_party/engine/

# Generierte AOT-Zwischenstufen (2,5 MB Assembly + 4 MB Kernel),
# reproduzierbar per scripts/build-aot-poc.ps1
examples/aot_poc/generated/

# Build-Artefakte
build/
*.nro
*.nso
*.elf
*.nacp
*.o
*.d

# Flutter/Dart
.dart_tool/
.packages
examples/**/build/
build-logs/
examples/*/generated/
examples/*/romfs/
# Gerüst, das flutter build bundle selbst anlegt, sobald es in einem
# Flutter-Projekt eine Datei vermisst (beobachtet am Beispiel-Paket
# examples/ui_app/dart). Nicht Teil des Beispiels, daher nicht versionieren.
.metadata
.idea/
*.iml
analysis_options.yaml
examples/*/dart/web/
# Автогенерируемая NRO-иконка (build-dart-app.sh из логотипа/mipmap проекта)
examples/*/icon.jpg

# macOS
.DS_Store
.AppleDouble
._*

# Lokale Build-/Checkout-Ausgaben des macOS-Ports
out/
__pycache__/ 
examples/romashka_game/*

# Laufende Konsolenprotokolle. Sie werden zur Auswertung ins Arbeitsverzeichnis
# kopiert, sind aber kein Quellstand: romashka_game.log waechst im Lauf auf
# mehrere tausend Zeilen und wuerde bei jedem Commit die Historie zuschuetten.
examples/*/*.log
examples/*/*.log.alt
